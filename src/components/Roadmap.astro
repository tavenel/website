---
export interface Props {
  chapters: { slug: string; url: string; title: string; type: string }[];
  trackSlug: string;
}

const { chapters, trackSlug } = Astro.props;
const nodeCount = chapters.length;
const svgWidth = Math.max(600, nodeCount * 180);
const svgHeight = 300;

// Layout: horizontal line with nodes evenly spaced
const nodeRadius = 16;
const startX = 40;
const endX = svgWidth - 40;
const y = svgHeight / 2;
const spacing = nodeCount > 1 ? (endX - startX) / (nodeCount - 1) : 0;
---

<div class="roadmap-wrapper" data-track={trackSlug}>
  <svg 
    viewBox="0 0 {svgWidth} {svgHeight}" 
    class="roadmap-svg"
    aria-label="Roadmap du cours {chapters.length} chapitres"
  >
    <!-- Connection line -->
    <line 
      x1={startX} y1={y} x2={endX} y2={y} 
      stroke="#ccc" stroke-width="2" 
    />

    <!-- Nodes -->
    {chapters.map((chapter, i) => {
      const x = nodeCount > 1 ? startX + i * spacing : svgWidth / 2;
      return (
        <>
          <!-- Node circle -->
          <a href={chapter.url}>
            <circle 
              cx={x} cy={y} r={nodeRadius}
              fill="var(--node-bg, #0077cc)" 
              stroke="var(--node-border, #003f80)" 
              stroke-width="2"
              class="roadmap-node"
              data-chapter={chapter.slug}
            />
            <text 
              x={x} y={y} 
              text-anchor="middle" 
              dominant-baseline="central"
              fill="white" 
              font-size="0.7rem"
              font-weight="bold"
            >
              {i + 1}
            </text>
          </a>
          <!-- Label -->
          <a href={chapter.url}>
            <text 
              x={x} y={y + nodeRadius + 14} 
              text-anchor="middle" 
              fill="var(--text-color, #333)" 
              font-size="0.65rem"
              class="roadmap-label"
            >
              {chapter.title.slice(0, 30)}{chapter.title.length > 30 ? '…' : ''}
            </text>
          </a>
          <!-- Type badge -->
          <text 
            x={x} y={y - nodeRadius - 6} 
            text-anchor="middle" 
            fill="#888" 
            font-size="0.5rem"
            class="roadmap-type"
          >
            {chapter.type}
          </text>
        </>
      );
    })}
  </svg>

  <!-- No-JS fallback: plain ordered list -->
  <noscript>
    <ol class="roadmap-fallback">
      {chapters.map((chapter) => (
        <li><a href={chapter.url}>{chapter.title}</a></li>
      ))}
    </ol>
  </noscript>
</div>

<style>
  .roadmap-wrapper {
    overflow-x: auto;
    padding: 1rem 0;
    max-width: 100%;
  }
  .roadmap-svg {
    display: block;
    margin: 0 auto;
  }
  .roadmap-node {
    cursor: pointer;
    transition: fill 0.2s, r 0.2s;
  }
  .roadmap-node:hover {
    fill: #0055aa;
    r: 18;
  }
  .roadmap-label {
    cursor: pointer;
    transition: fill 0.2s;
  }
  .roadmap-label:hover {
    fill: #0077cc;
  }
  .roadmap-fallback {
    max-width: 40rem;
    margin: 1rem auto;
  }
</style>

<script>
  import type { Props } from './Roadmap.astro';

  const wrapper = document.querySelector('.roadmap-wrapper') as HTMLElement;
  if (!wrapper) throw new Error('Roadmap wrapper not found');

  const trackSlug = wrapper.dataset.track || '';
  const STORAGE_KEY = `roadmap-progress-${trackSlug}`;

  // Load progress from localStorage
  function loadProgress(): Set<string> {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? new Set(JSON.parse(raw)) : new Set();
    } catch {
      return new Set();
    }
  }

  // Save progress to localStorage
  function saveProgress(progress: Set<string>): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify([...progress]));
    } catch {
      // localStorage might be full or disabled
    }
  }

  // Toggle a chapter as completed
  function toggleChapter(chapterSlug: string): void {
    const progress = loadProgress();
    if (progress.has(chapterSlug)) {
      progress.delete(chapterSlug);
    } else {
      progress.add(chapterSlug);
    }
    saveProgress(progress);
    updateUI(progress);
  }

  // Update UI to reflect progress
  function updateUI(progress: Set<string>): void {
    document.querySelectorAll('.roadmap-node').forEach((node) => {
      const slug = node.getAttribute('data-chapter');
      if (slug && progress.has(slug)) {
        node.classList.add('completed');
        node.setAttribute('fill', '#4caf50');
      } else {
        node.classList.remove('completed');
        node.setAttribute('fill', 'var(--node-bg, #0077cc)');
      }
    });
  }

  // Deep link from hash
  function checkHash(): void {
    const hash = window.location.hash;
    if (hash.startsWith('#chapter-')) {
      const slug = hash.slice(9);
      const node = document.querySelector(`[data-chapter="${slug}"]`) as SVGElement | null;
      if (node) {
        node.scrollIntoView({ behavior: 'smooth', block: 'center' });
        node.setAttribute('r', '22');
        setTimeout(() => node.setAttribute('r', '16'), 1000);
      }
    }
  }

  // Initialize
  const progress = loadProgress();
  updateUI(progress);
  checkHash();

  // Listen for clicks on nodes to toggle progress
  wrapper.addEventListener('click', (e: MouseEvent) => {
    const target = e.target as Element;
    const node = target.closest('[data-chapter]') as SVGElement | null;
    if (node) {
      e.preventDefault();
      const slug = node.getAttribute('data-chapter') || '';
      toggleChapter(slug);
    }
  });

  // Listen for hash changes
  window.addEventListener('hashchange', checkHash);
</script>