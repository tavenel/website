---
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;

/** Find a sidebar entry matching a predicate. */
function findEntry(entries: any[], pred: (e: any) => boolean): any | null {
  for (const e of entries) {
    if (pred(e)) return e;
    if (e.entries) { const f = findEntry(e.entries, pred); if (f) return f; }
  }
  return null;
}

function findDeepestGroup(entries: any[], href: string): any[] | null {
  for (const e of entries) {
    if (e.type === 'group' && e.entries) {
      for (const child of e.entries) {
        if (child.type === 'link' && child.href === href) return e.entries;
      }
      const r = findDeepestGroup(e.entries, href);
      if (r) return r;
    }
  }
  return null;
}

let displaySidebar = sidebar;

if (pathname.startsWith('/tracks/') && pathname !== '/tracks/') {
  const current = findEntry(sidebar, (e: any) => e.type === 'link' && e.isCurrent);
  if (current) {
    const siblings = findDeepestGroup(sidebar, current.href);
    if (siblings) {
      displaySidebar = [
        { type: 'link' as const, label: '← Accueil', href: '/', isCurrent: false, badge: undefined, attrs: {} },
        ...siblings,
      ];
    }
  }
}
---

<SidebarPersister>
	<SidebarSublist sublist={displaySidebar} />
</SidebarPersister>