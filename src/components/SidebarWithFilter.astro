---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
---

<div class="sidebar-filter" data-sidebar-filter-root>
  <label class="sr-only" for="sidebar-filter-input">
    Filter documentation pages
  </label>

  <input
    id="sidebar-filter-input"
    data-sidebar-filter-input
    type="search"
    placeholder="Filter pages..."
    autocomplete="off"
    spellcheck="false"
    aria-controls="starlight__sidebar"
  />

  <p class="sidebar-filter__hint">
    ↑ ↓ navigate · Enter open · Esc clear
  </p>

  <p
    class="sidebar-filter__status"
    data-sidebar-filter-status
    role="status"
    aria-live="polite"
    hidden
  ></p>
</div>

<DefaultSidebar />

<script>
  const initSidebarFilter = () => {
    const pane = document.getElementById('starlight__sidebar');
    if (!pane) return;

    const wrapper = pane.querySelector('[data-sidebar-filter-root]');
    const input = wrapper?.querySelector('[data-sidebar-filter-input]');
    const list = pane.querySelector('ul.top-level');

    if (
      !(input instanceof HTMLInputElement) ||
      !list ||
      wrapper.dataset.initialized === 'true'
    ) {
      return;
    }

    wrapper.dataset.initialized = 'true';

    const status = wrapper.querySelector('[data-sidebar-filter-status]');

    let savedDetailsState = null;

    const normalize = (value) =>
      String(value)
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase();

    // Include the visible page title and its URL path/slug.
    const getLinkSearchText = (anchor) => {
      const href = anchor.getAttribute('href') || '';

      let pathname = href;

      try {
        pathname = new URL(href, window.location.href).pathname;
      } catch {}

      try {
        pathname = decodeURIComponent(pathname);
      } catch {}

      const filename = pathname
        .replace(/\/+$/, '')
        .split('/')
        .pop() || '';

      return normalize(
        `${anchor.textContent} ${pathname} ${filename.replace(/[-_]/g, ' ')}`
      );
    };

    // Show all entries recursively, for a matching group name.
    const revealAll = (ul) => {
      for (const li of ul.children) {
        if (!(li instanceof HTMLLIElement)) continue;

        li.hidden = false;

        const details = li.querySelector(':scope > details');

        if (details) {
          details.open = true;

          const nested = details.querySelector(':scope > ul');

          if (nested) revealAll(nested);
        }
      }
    };

    // Filter a sidebar list recursively.
    const filterList = (ul, query) => {
      let hasMatches = false;

      for (const li of ul.children) {
        if (!(li instanceof HTMLLIElement)) continue;

        const anchor = li.querySelector(':scope > a');

        if (anchor) {
          const matches = getLinkSearchText(anchor).includes(query);

          li.hidden = !matches;
          hasMatches ||= matches;

          continue;
        }

        const details = li.querySelector(':scope > details');

        if (details) {
          const summary = details.querySelector(':scope > summary');
          const nested = details.querySelector(':scope > ul');

          const groupLabel = normalize(summary?.textContent || '');

          // If the group name matches, reveal all its children.
          if (groupLabel.includes(query)) {
            li.hidden = false;
            details.open = true;

            if (nested) revealAll(nested);

            hasMatches = true;
            continue;
          }

          // Otherwise, show only groups containing matching pages.
          if (nested) {
            const childMatches = filterList(nested, query);

            li.hidden = !childMatches;

            if (childMatches) details.open = true;

            hasMatches ||= childMatches;
          } else {
            li.hidden = true;
          }

          continue;
        }

        const matches = normalize(li.textContent).includes(query);

        li.hidden = !matches;
        hasMatches ||= matches;
      }

      return hasMatches;
    };

    const getVisibleLinks = () =>
      [...list.querySelectorAll('a[href]')].filter(
        (anchor) => !anchor.closest('li[hidden]')
      );

    const updateFilter = () => {
      const rawQuery = input.value.trim();

      // Allow searching for filenames such as example.md.
      const query = normalize(rawQuery).replace(/\.(md|mdx)$/, '');

      if (!query) {
        // Restore the original sidebar visibility and group states.
        for (const li of list.querySelectorAll('li')) {
          li.hidden = false;
        }

        if (savedDetailsState) {
          for (const [details, wasOpen] of savedDetailsState) {
            details.open = wasOpen;
          }

          savedDetailsState = null;
        }

        status.hidden = true;
      } else {
        // Save the original expanded/collapsed state only once.
        if (!savedDetailsState) {
          savedDetailsState = new Map(
            [...list.querySelectorAll('details')].map((details) => [
              details,
              details.open,
            ])
          );
        }

        filterList(list, query);

        const count = getVisibleLinks().length;

        status.textContent =
          count === 0
            ? 'No matching pages.'
            : `${count} matching ${count === 1 ? 'page' : 'pages'}.`;

        status.hidden = false;
      }

      // Avoid leaving keyboard focus on an item that is now hidden.
      const activeElement = document.activeElement;

      if (
        activeElement instanceof HTMLElement &&
        activeElement.closest('li[hidden]')
      ) {
        input.focus();
      }
    };

    input.addEventListener('input', updateFilter);

    // Keyboard navigation through visible sidebar links.
    pane.addEventListener('keydown', (event) => {
      const target = event.target;

      const inputFocused = target === input;
      const linkFocused =
        target instanceof HTMLAnchorElement &&
        target.closest('#starlight__sidebar');

      if (event.key === 'Escape' && (inputFocused || linkFocused)) {
        event.preventDefault();

        input.value = '';
        updateFilter();
        input.focus();

        return;
      }

      if (
        (event.key === 'ArrowDown' || event.key === 'ArrowUp') &&
        (inputFocused || linkFocused)
      ) {
        const links = getVisibleLinks();

        if (!links.length) return;

        event.preventDefault();

        const currentIndex = linkFocused
          ? links.indexOf(target)
          : -1;

        const nextIndex = inputFocused
          ? event.key === 'ArrowDown'
            ? 0
            : links.length - 1
          : (currentIndex +
              (event.key === 'ArrowDown' ? 1 : -1) +
              links.length) %
            links.length;

        links[nextIndex].focus();

        return;
      }

      // Enter on the search field opens the first matching page.
      if (inputFocused && event.key === 'Enter') {
        const firstLink = getVisibleLinks()[0];

        if (firstLink) {
          event.preventDefault();
          firstLink.click();
        }
      }
    });
  };

  initSidebarFilter();

  // Also initialize after Astro client-side navigation.
  document.addEventListener('astro:page-load', initSidebarFilter);
</script>

<style>
  .sidebar-filter {
    width: 100%;
  }

  .sidebar-filter input {
    box-sizing: border-box;
    width: 100%;
    padding: 0.65rem 0.75rem;

    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;

    background: var(--sl-color-bg);
    color: var(--sl-color-text);

    font: inherit;
    font-size: var(--sl-text-sm);
  }

  .sidebar-filter input::placeholder {
    color: var(--sl-color-gray-3);
  }

  .sidebar-filter input:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .sidebar-filter__hint,
  .sidebar-filter__status {
    margin: 0.4rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

