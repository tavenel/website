---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
---

<div class="sidebar-filter" data-sidebar-filter-root>
	<label class="sr-only" for="sidebar-filter-input">
		Filter documentation directories
	</label>

	<input
			id="sidebar-filter-input"
			data-sidebar-filter-input
			type="search"
			placeholder="Filter..."
			autocomplete="off"
			spellcheck="false"
			aria-controls="starlight__sidebar"
			/>

			<div class="sidebar-filter__modes" role="group" aria-label="Search mode">
				<button
						type="button"
						data-filter-mode="directories"
						aria-pressed="true"
						>
						Cours
				</button>

					<button
							type="button"
							data-filter-mode="pages"
							aria-pressed="false"
							>
							Pages
					</button>
			</div>

			<p class="sidebar-filter__hint">
			↑ ↓ navigate · Enter open · Esc clear
			</p>

			<p
					class="sidebar-filter__status"
					data-sidebar-filter-status
					role="status"
					aria-live="polite"
					hidden
					></p>
</div>

<DefaultSidebar />

<script>


	const initSidebarFilter = () => {
		const pane = document.getElementById('starlight__sidebar');
		if (!pane) return;

		const wrapper = pane.querySelector('[data-sidebar-filter-root]');
		const input = wrapper?.querySelector('[data-sidebar-filter-input]');
		const list = pane.querySelector('ul.top-level');

		if (
			!(input instanceof HTMLInputElement) ||
			!list ||
			wrapper.dataset.initialized === 'true'
		) {
			return;
		}

		wrapper.dataset.initialized = 'true';

		const status = wrapper.querySelector('[data-sidebar-filter-status]');
		const modeButtons = [
			...wrapper.querySelectorAll('button[data-filter-mode]'),
		];

		let mode = 'directories';
		let savedDetailsState = null;

		const normalize = (value) =>
			String(value)
				.normalize('NFD')
				.replace(/[\u0300-\u036f]/g, '')
				.toLowerCase();

		const getPath = (anchor) => {
			let pathname = anchor.getAttribute('href') || '';

			try {
				pathname = new URL(pathname, window.location.href).pathname;
			} catch {}

			try {
				pathname = decodeURIComponent(pathname);
			} catch {}

			return pathname;
		};

		// Directory path = URL without its final page segment.
		const getDirectoryPath = (anchor) =>
			getPath(anchor).split('/').filter(Boolean).slice(0, -1);

		// Search text for directory groups.
		const getGroupSearchText = (details) => {
			const summary = details.querySelector(':scope > summary');
			const anchors = [...details.querySelectorAll('a[href]')];

			const paths = anchors.map(getDirectoryPath);
			let commonPath = paths[0] || [];

			for (const path of paths.slice(1)) {
				let i = 0;

				while (
					i < commonPath.length &&
					i < path.length &&
					commonPath[i] === path[i]
				) {
					i++;
				}

				commonPath = commonPath.slice(0, i);
			}

			return normalize(
				`${summary?.textContent || ''} ${commonPath.join('/')}`
			);
		};

		// Search text for individual pages.
		const getPageSearchText = (anchor) => {
			const pathname = getPath(anchor);
			const filename = pathname.split('/').filter(Boolean).pop() || '';

			return normalize(
				`${anchor.textContent} ${pathname} ${filename.replace(/[-_]/g, ' ')}`
			);
		};

		const filterList = (ul, query) => {
			let hasMatches = false;

			for (const li of ul.children) {
				if (!(li instanceof HTMLLIElement)) continue;

				const directLink = li.querySelector(':scope > a[href]');

				// Leaf: individual page.
				if (directLink) {
					const matches =
						mode === 'pages' &&
						getPageSearchText(directLink).includes(query);

					li.hidden = !matches;
					li.dataset.sidebarFilterMatch = String(matches);

					hasMatches ||= matches;
					continue;
				}

				// Group: directory.
				const details = li.querySelector(':scope > details');

				if (!details) {
					li.hidden = true;
					continue;
				}

				const nested = details.querySelector(':scope > ul');

				// Search descendants first.
				const childMatches = nested
					? filterList(nested, query)
					: false;

				// Only directory mode matches group names and paths.
				const matches =
					mode === 'directories' &&
					getGroupSearchText(details).includes(query);

				li.hidden = !matches && !childMatches;
				li.dataset.sidebarFilterMatch = String(matches);

				// Expand directories containing matching descendants.
				details.open = childMatches;

				hasMatches ||= matches || childMatches;
			}

			return hasMatches;
		};

		const getVisibleTargets = () => {
			const selector =
				mode === 'directories'
				? 'li[data-sidebar-filter-match="true"] > details > summary'
				: 'li[data-sidebar-filter-match="true"] > a[href]';

			return [...list.querySelectorAll(selector)].filter(
				(element) =>
				!element.closest('li[hidden]') &&
				element.getClientRects().length > 0
			);
		};

		const updateModeButtons = () => {
			for (const button of modeButtons) {
				button.setAttribute(
					'aria-pressed',
					String(button.dataset.filterMode === mode)
				);
			}

			input.placeholder =
				mode === 'directories'
				? 'Filtrer les cours...'
				: 'Filtrer les pages...';
		};

		const updateFilter = () => {
			const rawQuery = input.value.trim();

			// Also accept searches such as "example.md".
			const query = normalize(rawQuery).replace(/\.(md|mdx)$/, '');

			if (!query) {
				// Restore original visibility.
				for (const li of list.querySelectorAll('li')) {
					li.hidden = false;
					delete li.dataset.sidebarFilterMatch;
				}

				// Restore original expanded/collapsed state.
				if (savedDetailsState) {
					for (const [details, wasOpen] of savedDetailsState) {
						details.open = wasOpen;
					}

					savedDetailsState = null;
				}

				status.hidden = true;
			} else {
				// Save original state only once.
				if (!savedDetailsState) {
					savedDetailsState = new Map(
						[...list.querySelectorAll('details')].map((details) => [
							details,
							details.open,
						])
					);
				}

				filterList(list, query);

				const count = list.querySelectorAll(
					'li[data-sidebar-filter-match="true"]'
				).length;

				status.textContent =
					count === 0
					? `Aucun résultat.`
					: `${count} résultats.`;

				status.hidden = false;
			}

			// Restore focus if the active item became hidden.
			const activeElement = document.activeElement;

			if (
				activeElement instanceof HTMLElement &&
				activeElement.closest('li[hidden]')
			) {
				input.focus();
			}
		};

		// Switch between directories and pages.
		for (const button of modeButtons) {
			button.addEventListener('click', () => {
				const nextMode = button.dataset.filterMode;

				if (nextMode !== 'directories' && nextMode !== 'pages') return;

				mode = nextMode;
				updateModeButtons();
				updateFilter();
				input.focus();
			});
		}

		input.addEventListener('input', updateFilter);

		// Keyboard navigation.
		pane.addEventListener('keydown', (event) => {
			const target = event.target;

			const inputFocused = target === input;

			const itemFocused =
				target instanceof HTMLElement &&
				target.matches('a[href], summary') &&
				!!target.closest('#starlight__sidebar');

			if (event.key === 'Escape' && (inputFocused || itemFocused)) {
				event.preventDefault();

				input.value = '';
				updateFilter();
				input.focus();

				return;
			}

			if (
				(event.key === 'ArrowDown' || event.key === 'ArrowUp') &&
				(inputFocused || itemFocused)
			) {
				const targets = getVisibleTargets();

				if (!targets.length) return;

				event.preventDefault();

				const currentIndex = itemFocused
					? targets.indexOf(target)
					: -1;

				const nextIndex = inputFocused
					? event.key === 'ArrowDown'
					? 0
					: targets.length - 1
					: (
						currentIndex +
						(event.key === 'ArrowDown' ? 1 : -1) +
						targets.length
					) % targets.length;

				targets[nextIndex].focus();

				return;
			}

			// Enter opens the first matching directory or page.
			if (inputFocused && event.key === 'Enter') {
				const first = getVisibleTargets()[0];

				if (!first) return;

				event.preventDefault();

				if (mode === 'directories') {
					first.parentElement.open = true;
					first.focus();
				} else {
					first.click();
				}
			}
		});

		updateModeButtons();
	};

	initSidebarFilter();

	document.addEventListener('astro:page-load', initSidebarFilter);

</script>

<style>
	.sidebar-filter {
		width: 100%;
	}

	.sidebar-filter input {
		box-sizing: border-box;
		width: 100%;
		padding: 0.65rem 0.75rem;

		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;

		background: var(--sl-color-bg);
		color: var(--sl-color-text);

		font: inherit;
		font-size: var(--sl-text-sm);
	}

	.sidebar-filter input::placeholder {
		color: var(--sl-color-gray-3);
	}

	.sidebar-filter input:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}

	.sidebar-filter__hint,
	.sidebar-filter__status {
		margin: 0.4rem 0 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}


	.sidebar-filter__modes {
		display: flex;
		gap: 0.35rem;
		margin-top: 0.6rem;
	}

	.sidebar-filter__modes button {
		flex: 1;
		padding: 0.4rem 0.5rem;

		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.4rem;

		background: transparent;
		color: var(--sl-color-gray-2);

		font: inherit;
		font-size: var(--sl-text-xs);
		cursor: pointer;
	}

	.sidebar-filter__modes button[aria-pressed="true"] {
		background: var(--sl-color-accent-low);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-text-accent);
	}

	.sidebar-filter__modes button:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}

</style>

